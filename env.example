APP_NAME="NusantaraAI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nusantaraai
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─────────────────────────────────────────────────────────────────
# GEMINI AI — Dapatkan API Key gratis di: https://aistudio.google.com/
# ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────
# IMAGE APIs — Sumber gambar destinasi wisata (multi-source fallback)
#
# Urutan prioritas: Database lokal → Unsplash → Pexels → Wikimedia
#
# [1] UNSPLASH (UTAMA) — 50 request/jam (gratis)
#     Daftar & dapatkan Access Key di: https://unsplash.com/developers
#     → Buat app → Copy "Access Key"
# ─────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ─────────────────────────────────────────────────────────────────
# [2] PEXELS (BACKUP) — 200 request/jam, 20.000/bulan (gratis)
#     Daftar & dapatkan API Key di: https://www.pexels.com/api/
#     → "Your API Key" di dashboard
# ─────────────────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here

# ─────────────────────────────────────────────────────────────────
# [3] WIKIMEDIA (FALLBACK TERAKHIR) — tidak perlu API key
# ─────────────────────────────────────────────────────────────────
WIKIMEDIA_API_DOMAIN="wikipedia.org"

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@nusantaraai.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
